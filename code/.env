# FastAPI
APP_PORT=8000

# GraphDB (container’s internal URL, used by the FastAPI app)
GRAPHDB_URL=http://graphdb:7200
GRAPHDB_REPOSITORY=prodRepo

# GraphDB JVM memory (adjust to your machine)
GDB_HEAP_SIZE=2g
